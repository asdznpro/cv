{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,

		"plugins": [
			{
				"name": "next"
			}
		],

		"paths": {
			"@/*": ["./*"],

			// app layer

			"providers": ["./src/app/providers"],
			"store": ["./src/app/store"],

			"styles/*": ["./src/app/styles/*"],
			"styles": ["./src/app/styles"],

			// shared

			"shared/*": ["./src/shared/*"],
			"shared": ["./src/shared"],

			"config/*": ["./src/shared/config/*"],
			"config": ["./src/shared/config"],

			"data/*": ["./src/shared/data/*"],
			"data": ["./src/shared/data"],

			"enums/*": ["./src/shared/enums/*"],
			"enums": ["./src/shared/enums"],

			"locales/*": ["./src/shared/locales/*"],
			"locales": ["./src/shared/locales"],

			"schemas/*": ["./src/shared/schemas/*"],
			"schemas": ["./src/shared/schemas"],

			"types/*": ["./src/shared/types/*"],
			"types": ["./src/shared/types"],

			"ui/*": ["./src/shared/ui/*"],
			"ui": ["./src/shared/ui"],

			// lib

			"lib/*": ["./src/shared/lib/*"],
			"lib": ["./src/shared/lib"],

			// "hooks/*": ["./src/shared/lib/hooks/*"],
			// "hooks": ["./src/shared/lib/hooks"],

			// "utils/*": ["./src/shared/lib/utils/*"],
			// "utils": ["./src/shared/lib/utils"],

			// widgets

			"widgets/*": ["./src/widgets/*"],
			"widgets": ["./src/widgets"]
		}
	},

	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],

	"exclude": ["node_modules"]
}
